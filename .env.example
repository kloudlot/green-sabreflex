# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Leave both blank (or delete .env) to run off the bundled snapshot in
# src/data/raw.js. Setting VITE_SHEET_ENDPOINT is the only step needed to
# switch the dashboard to live sheet data.

# The Apps Script web app /exec URL. See apps-script/Code.gs for deploy steps.
VITE_SHEET_ENDPOINT=https://script.google.com/macros/s/AKfycbzrKwCaRPkgEVGOOZ4RkDGl5NHn_Z-lw11_0AML6GQ6UkUot3VDx73ysVurgaWqs6-P/exec

# Must match the TOKEN constant in the deployed Apps Script.
# Generate one with: openssl rand -hex 24
VITE_SHEET_TOKEN=PsoiYQ736878930d9wgdwdw8fuhkj

# Show the "Save to sheet" button for project budgets. Off unless "true".
# Also requires ALLOW_WRITES = true in the deployed Apps Script — read the
# security note at the top of apps-script/Code.gs before enabling either.
VITE_ENABLE_WRITEBACK=true
